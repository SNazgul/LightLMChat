<Window x:Class="LightLMChat.ExampleApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chat="clr-namespace:LightLMChat.Wpf;assembly=LightLMChat.Wpf"
        Title="IBM PC Parts Catalog (286–486) — LightLMChat Example"
        Height="720" Width="1180" MinHeight="480" MinWidth="880">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="ModelBanner" Visibility="Collapsed" Padding="12" Margin="12,12,12,0"
                Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1" CornerRadius="4">
            <TextBlock x:Name="ModelBannerText" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460" MinWidth="320" />
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- Read-only catalog browser -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Parts catalog" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
                <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,0,0,8" Padding="4"
                         AutomationProperties.Name="Search parts"
                         TextChanged="SearchBox_TextChanged" />

                <ListBox x:Name="PartsList" Grid.Row="2" SelectionChanged="PartsList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Subtype}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Company}" Opacity="0.7" />
                                <TextBlock Text="{Binding Type}" Opacity="0.55" FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3" Margin="0,8,0,0" Padding="10" CornerRadius="6"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="DetailSubtype" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailMeta" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="DetailCharacteristics" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="DetailDescription" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- AI chat -->
            <chat:LightLmChatControl x:Name="Chat" Grid.Column="1" />
        </Grid>
    </Grid>
</Window>
