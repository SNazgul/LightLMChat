<UserControl x:Class="LightLMChat.Wpf.LightLmChatControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320" MinHeight="300">
    <UserControl.Resources>
        <Style x:Key="RoundIconButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E40AF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="16,12" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="Clear chat" MinWidth="76"
                        Margin="12,0,0,0" Click="ClearButton_Click" />
                <StackPanel>
                    <TextBlock Text="LightLMChat" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Local application assistant" Opacity="0.7" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="TranscriptScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12"
                      AutomationProperties.Name="Conversation">
            <ItemsControl ItemsSource="{Binding Messages, ElementName=Root}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4,0,8" Padding="12" CornerRadius="8"
                                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Role}" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                         IsTabStop="False" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0"
                                         ContextMenuService.ContextMenuOpening="MessageTextBox_ContextMenuOpening">
                                    <TextBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy" Tag="copy-selection" Click="CopySelectionMenuItem_Click" />
                                            <MenuItem Header="Copy message" Click="CopyMessageMenuItem_Click" />
                                            <Separator />
                                            <MenuItem Header="Select all" Click="SelectAllMenuItem_Click" />
                                        </ContextMenu>
                                    </TextBox.ContextMenu>
                                </TextBox>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="12" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,1,0,0">
            <StackPanel>
                <Border x:Name="NoticeBanner" Visibility="Collapsed"
                        Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                    <TextBlock x:Name="NoticeLabel" TextWrapping="Wrap" />
                </Border>
                <TextBlock x:Name="StatusLabel" Text="Ready" Opacity="0.7" Margin="2,0,0,8"
                           AutomationProperties.Name="Status" AutomationProperties.LiveSetting="Polite" />
                <Border CornerRadius="8"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        BorderThickness="1" Padding="10,6">
                    <Grid>
                        <TextBox x:Name="Composer" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="36" MaxHeight="130"
                                 Padding="0,0,44,0"
                                 AutomationProperties.Name="Message"
                                 AutomationProperties.HelpText="Enter to send, Shift+Enter for a new line, Esc to cancel"
                                 PreviewKeyDown="Composer_PreviewKeyDown" />
                        <Button x:Name="SendButton" Style="{StaticResource RoundIconButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Click="SendButton_Click" AutomationProperties.Name="Send">
                            <Path Data="M3,3 L17,10 L3,17 Z" Fill="White" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="CancelButton" Style="{StaticResource RoundIconButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed"
                                Click="CancelButton_Click" AutomationProperties.Name="Cancel">
                            <Path Data="M6,6 L14,6 L14,14 L6,14 Z" Fill="White" Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>
                <TextBlock Text="Enter to send · Shift+Enter for a new line · Esc to cancel" Opacity="0.6" Margin="2,6,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
