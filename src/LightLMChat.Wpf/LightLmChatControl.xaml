<UserControl x:Class="LightLMChat.Wpf.LightLmChatControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320" MinHeight="300">
    <UserControl.Resources>
        <Style x:Key="ComposerActionButton" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#1D4ED8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="0" CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#94A3B8" />
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderActionButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModelPickerItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="8"
                                Margin="5,2" Padding="11,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="7" Height="7" Fill="#94A3B8"
                                         VerticalAlignment="Center" Margin="0,0,11,0" />
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                                  ContentSource="Content" TextElement.FontSize="13"
                                                  TextElement.FontWeight="Medium" />
                                <Path x:Name="SelectedMark" Grid.Column="2" Visibility="Collapsed"
                                      Data="M 1,6 L 5,10 L 12,2" Stroke="#2563EB" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Width="14" Height="14"
                                      Margin="12,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#EFF6FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#EAF1FF" />
                                <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModelPickerStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="126" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModelPickerItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="PickerToggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="PickerSurface" Background="Transparent"
                                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="7">
                                            <Grid Margin="8,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="6" Height="6" Fill="#16A34A"
                                                         VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                           Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="#0F172A"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Path Grid.Column="2" Data="M 1.5,3.5 L 5,7 L 8.5,3.5"
                                                      Stroke="#64748B" StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" Width="10" Height="10"
                                                      Stretch="None" VerticalAlignment="Center" Margin="5,0,0,0" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="PickerSurface" Property="BorderBrush" Value="#CBD5E1" />
                                                <Setter TargetName="PickerSurface" Property="Background" Value="#F1F5F9" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="PickerSurface" Property="BorderBrush" Value="#93C5FD" />
                                                <Setter TargetName="PickerSurface" Property="Background" Value="#EFF6FF" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="PickerSurface" Property="Opacity" Value="0.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="FocusOutline" BorderBrush="#2563EB" BorderThickness="2"
                                    CornerRadius="8" Margin="-2" Visibility="Collapsed"
                                    IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" Placement="Top" AllowsTransparency="True"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Width="250" Margin="0,0,0,7" Padding="5,7"
                                        Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                                        CornerRadius="12">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#0F172A" BlurRadius="18" ShadowDepth="4" Opacity="0.16" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="CHOOSE A MODEL" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#64748B" Margin="12,3,0,6" />
                                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="16,12" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="Clear chat" MinWidth="76"
                        Style="{StaticResource HeaderActionButton}"
                        Margin="12,0,0,0" VerticalAlignment="Top" Click="ClearButton_Click" />
                <StackPanel>
                    <TextBlock Text="LightLMChat" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Local application assistant" Opacity="0.7" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="TranscriptScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12"
                      AutomationProperties.Name="Conversation">
            <ItemsControl ItemsSource="{Binding Messages, ElementName=Root}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4,0,8" Padding="12" CornerRadius="8"
                                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Role}" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                         IsTabStop="False" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0"
                                         ContextMenuService.ContextMenuOpening="MessageTextBox_ContextMenuOpening">
                                    <TextBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy" Tag="copy-selection" Click="CopySelectionMenuItem_Click" />
                                            <MenuItem Header="Copy message" Click="CopyMessageMenuItem_Click" />
                                            <Separator />
                                            <MenuItem Header="Select all" Click="SelectAllMenuItem_Click" />
                                        </ContextMenu>
                                    </TextBox.ContextMenu>
                                </TextBox>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="16,12,16,14"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="0,1,0,0">
            <StackPanel>
                <Border x:Name="NoticeBanner" Visibility="Collapsed"
                        Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                    <TextBlock x:Name="NoticeLabel" TextWrapping="Wrap" />
                </Border>
                <Grid Margin="2,0,2,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MESSAGE" FontSize="11" FontWeight="SemiBold" Opacity="0.62"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusLabel" Grid.Column="1" Text="Ready" FontSize="11"
                               Opacity="0.68" VerticalAlignment="Center" MaxWidth="260"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="Status" AutomationProperties.LiveSetting="Polite" />
                </Grid>
                <Border x:Name="ComposerShell" CornerRadius="14"
                        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                        Padding="14,12,10,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="#2563EB" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid MinHeight="44">
                            <TextBox x:Name="Composer" BorderThickness="0" Background="Transparent"
                                     TextWrapping="Wrap" AcceptsReturn="True" FontSize="14"
                                     VerticalScrollBarVisibility="Auto" MinHeight="44" MaxHeight="132"
                                     Padding="0" TextChanged="Composer_TextChanged"
                                     GotKeyboardFocus="Composer_FocusChanged"
                                     LostKeyboardFocus="Composer_FocusChanged"
                                     AutomationProperties.Name="Message"
                                     AutomationProperties.HelpText="Enter to send, Shift+Enter for a new line, Esc to cancel"
                                     PreviewKeyDown="Composer_PreviewKeyDown" />
                            <TextBlock x:Name="ComposerPlaceholder" Text="Ask about your data…"
                                       FontSize="14" Opacity="0.48" Margin="2,2,0,0"
                                       VerticalAlignment="Top" IsHitTestVisible="False" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FooterHint" Grid.Row="1" Text="Enter to send  ·  Shift+Enter for a new line"
                                       FontSize="11" Opacity="0.58" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,0,10,0" />
                            <ComboBox x:Name="ModelSelector" Grid.Row="1" Visibility="Collapsed"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Style="{StaticResource ModelPickerStyle}"
                                      SelectionChanged="ModelSelector_SelectionChanged"
                                      ToolTip="Choose the local model for this conversation"
                                      AutomationProperties.Name="Local model"
                                      AutomationProperties.HelpText="Choose the local model used for this conversation" />
                            <Button x:Name="SendButton" Grid.Row="1" Grid.Column="1"
                                    Style="{StaticResource ComposerActionButton}" IsEnabled="False"
                                    Click="SendButton_Click" ToolTip="Send message (Enter)"
                                    AutomationProperties.Name="Send message">
                                <Path Data="M12,17 L12,4 M5,11 L12,4 L19,11" Stroke="White"
                                      StrokeThickness="2.2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="20" Height="20" Stretch="Uniform" />
                            </Button>
                            <Button x:Name="CancelButton" Grid.Row="1" Grid.Column="1"
                                    Style="{StaticResource ComposerActionButton}" Background="#334155"
                                    Visibility="Collapsed" Click="CancelButton_Click"
                                    ToolTip="Stop response (Esc)" AutomationProperties.Name="Stop response">
                                <Rectangle Fill="White" Width="12" Height="12" RadiusX="2" RadiusY="2" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
