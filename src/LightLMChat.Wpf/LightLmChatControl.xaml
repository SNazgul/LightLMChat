<UserControl x:Class="LightLMChat.Wpf.LightLmChatControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320" MinHeight="300">
    <Grid Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="16,12" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="Clear chat" MinWidth="76"
                        Margin="12,0,0,0" Click="ClearButton_Click" />
                <StackPanel>
                    <TextBlock Text="LightLMChat" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Local application assistant" Opacity="0.7" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="TranscriptScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12"
                      AutomationProperties.Name="Conversation">
            <ItemsControl ItemsSource="{Binding Messages, ElementName=Root}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4,0,8" Padding="12" CornerRadius="8"
                                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Role}" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="12" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBlock x:Name="StatusLabel" Text="Ready" Opacity="0.7" Margin="2,0,0,8"
                           AutomationProperties.Name="Status" AutomationProperties.LiveSetting="Polite" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Composer" MinHeight="52" MaxHeight="130" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Message"
                             AutomationProperties.HelpText="Enter to send, Shift+Enter for a new line, Esc to cancel"
                             PreviewKeyDown="Composer_PreviewKeyDown" />
                    <Button x:Name="SendButton" Grid.Column="1" Content="Send" MinWidth="68" Margin="8,0,0,0"
                            IsDefault="False" Click="SendButton_Click" />
                    <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" MinWidth="68" Margin="8,0,0,0"
                            IsEnabled="False" Click="CancelButton_Click" />
                </Grid>
                <TextBlock Text="Enter to send · Shift+Enter for a new line · Esc to cancel" Opacity="0.6" Margin="2,6,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
